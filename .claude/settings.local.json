      "Read(//c//**)",
      "Bash(ls -la ~/Downloads 2>/dev/null | grep -i -E \"dizayn|yangilanish|v4\"; ls -la ~/Desktop 2>/dev/null | grep -i -E \"dizayn|yangilanish|v4\"; ls -la \"c:/Users/HP/Desktop\" 2>/dev/null | grep -i -E \"dizayn|yangilanish|v4\"; ls -la \"c:/Users/HP/Downloads\" 2>/dev/null | grep -i -E \"dizayn|yangilanish|v4\")",
      "Read(//c/Users/HP/Downloads/**)",
      "Read(//c/Users/HP/Desktop/**)",
      "Bash(echo $HOME; realpath ~; ls -la ~ | grep -i desktop; find \"$HOME\" -maxdepth 3 -iname \"*dizayn*\" 2>/dev/null)",
