// Asaka Mahalla AI — Prisma schema
// Dev: SQLite (file-based, zero setup). Production: switch provider to "postgresql"
// and set DATABASE_URL to a Postgres connection string — models below are portable as-is.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  BANKER
  ADMIN
}

enum ApplicationStatus {
  YANGI
  KORIB
  BOG
}

enum ListingType {
  IJARA
  ISH
  BOSHQA
}

enum MahallaStatus {
  FAOL
  FAOL_EMAS
}

enum BankerStatus {
  FAOL
  BLOKLANGAN
}

model Mahalla {
  id              String        @id
  nomi            String
  sector          String
  tuman           String        @default("Yunusobod")
  manzil          String        @default("")
  status          MahallaStatus @default(FAOL)
  /// True for the 7 real Yunusobod MFY seeded from official data — protected from deletion.
  isSeed          Boolean       @default(false)
  tashkil         Int
  aholi           Int
  erkak           Int
  ayol            Int
  xonadon         Int
  oila            Int
  tadbirkorlik    Int
  yatt            Int
  mchj            Int           @default(0)
  faoliyatTurlari String        @default("")
  vakansiya       Int
  drayver         String
  agent           String
  image           String?
  color           String
  /// SVG polygon points for the home-page map — absent for admin-added mahallas
  /// (they simply don't render on the map, only in the list).
  mapPoints       String?

  bankers              BankerMahalla[]
  applications         Application[]
  listings             Listing[]
  businessPlanRequests BusinessPlanRequest[]
  creditChatRequests   CreditChatRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banker {
  id                 String       @id @default(cuid())
  login              String       @unique
  passwordHash       String
  role               Role         @default(BANKER)
  status             BankerStatus @default(FAOL)
  /// Forces a redirect to the change-password page on next login — set after
  /// account creation or an admin-triggered password reset.
  mustChangePassword Boolean      @default(false)
  ism                String
  telefon            String?
  telegram           String?
  ishVaqti           String?
  lastLoginAt        DateTime?

  totpSecret  String?
  totpEnabled Boolean @default(false)

  mahallalar   BankerMahalla[]
  activityLogs ActivityLog[]
  listings     Listing[]
  loginLogs    LoginLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  bankerId  String?
  banker    Banker?  @relation(fields: [bankerId], references: [id], onDelete: SetNull)
  action    String
  detail    String?
  ipAddress String?
  createdAt DateTime @default(now())
}

/// One row per session — created at login, closed (logoutAt set) at logout.
/// A null logoutAt on a recent row means the session is still active.
model LoginLog {
  id        String   @id @default(cuid())
  bankerId  String
  banker    Banker   @relation(fields: [bankerId], references: [id], onDelete: Cascade)
  loginAt   DateTime @default(now())
  logoutAt  DateTime?
  ipAddress String?
  userAgent String?
}

// Explicit join table (banker <-> mahalla), many-to-many
model BankerMahalla {
  bankerId   String
  mahallaId  String
  banker     Banker   @relation(fields: [bankerId], references: [id], onDelete: Cascade)
  mahalla    Mahalla  @relation(fields: [mahallaId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  assignedBy String?

  @@id([bankerId, mahallaId])
}

model Application {
  id        String            @id @default(cuid())
  mahallaId String
  mahalla   Mahalla           @relation(fields: [mahallaId], references: [id], onDelete: Cascade)
  fio       String
  phone     String
  kredit    String
  izoh      String?
  status    ApplicationStatus @default(YANGI)
  createdAt DateTime          @default(now())
}

model Listing {
  id          String      @id @default(cuid())
  mahallaId   String
  mahalla     Mahalla     @relation(fields: [mahallaId], references: [id], onDelete: Cascade)
  turi        ListingType
  sarlavha    String
  tavsif      String
  narx        Int?
  manzil      String
  telefon     String
  amalMuddati DateTime?
  image       String?
  createdBy   String
  banker      Banker      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per "Biznes reja yordamchisi" survey submission — kept for the
/// admin Statistika tab, independent of whether the AI call succeeded.
model BusinessPlanRequest {
  id           String   @id @default(cuid())
  mahallaId    String
  mahalla      Mahalla  @relation(fields: [mahallaId], references: [id], onDelete: Cascade)
  soha         String
  budget       String
  tajriba      String
  jamoaHajmi   String
  matched      Boolean  @default(false)
  citizenName  String?
  citizenPhone String?
  createdAt    DateTime @default(now())
}

/// One row per credit-matching request from the button-driven "AI bilan
/// suhbat" widget — logged the same way as BusinessPlanRequest, for the
/// admin Statistika tab.
model CreditChatRequest {
  id               String   @id @default(cuid())
  mahallaId        String
  mahalla          Mahalla  @relation(fields: [mahallaId], references: [id], onDelete: Cascade)
  requestedAmount  Int
  employmentStatus String
  matchedCreditId  String
  citizenName      String?
  citizenPhone     String?
  createdAt        DateTime @default(now())
}

// Singleton row (id is always 1) holding platform-wide, admin-editable settings.
model SystemSettings {
  id                  Int      @id @default(1)
  aiPlannerYoqilgan   Boolean  @default(true)
  enforce2faForAdmins Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}
