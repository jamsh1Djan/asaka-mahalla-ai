// Asaka Mahalla AI — Prisma schema
// Dev: SQLite (file-based, zero setup). Production: switch provider to "postgresql"
// and set DATABASE_URL to a Postgres connection string — models below are portable as-is.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  BANKER
  ADMIN
}

enum ApplicationStatus {
  YANGI
  KORIB
  BOG
}

enum ListingType {
  IJARA
  ISH
  BOSHQA
}

model Mahalla {
  id            String   @id
  nomi          String
  sector        String
  tashkil       Int
  aholi         Int
  erkak         Int
  ayol          Int
  xonadon       Int
  oila          Int
  tadbirkorlik  Int
  yatt          Int
  mchj          Int    @default(0)
  faoliyatTurlari String @default("")
  vakansiya     Int
  drayver       String
  agent         String
  image         String?
  color         String
  mapPoints     String

  bankers       BankerMahalla[]
  applications  Application[]
  listings      Listing[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Banker {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  role         Role     @default(BANKER)
  ism          String
  telefon      String?
  telegram     String?
  ishVaqti     String?

  mahallalar   BankerMahalla[]
  activityLogs ActivityLog[]
  listings     Listing[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  bankerId  String?
  banker    Banker?  @relation(fields: [bankerId], references: [id], onDelete: SetNull)
  action    String
  detail    String?
  ipAddress String?
  createdAt DateTime @default(now())
}

// Explicit join table (banker <-> mahalla), many-to-many
model BankerMahalla {
  bankerId  String
  mahallaId String
  banker    Banker  @relation(fields: [bankerId], references: [id], onDelete: Cascade)
  mahalla   Mahalla @relation(fields: [mahallaId], references: [id], onDelete: Cascade)

  @@id([bankerId, mahallaId])
}

model Application {
  id        String            @id @default(cuid())
  mahallaId String
  mahalla   Mahalla           @relation(fields: [mahallaId], references: [id], onDelete: Cascade)
  fio       String
  phone     String
  kredit    String
  izoh      String?
  status    ApplicationStatus @default(YANGI)
  createdAt DateTime          @default(now())
}

model Listing {
  id          String      @id @default(cuid())
  mahallaId   String
  mahalla     Mahalla     @relation(fields: [mahallaId], references: [id], onDelete: Cascade)
  turi        ListingType
  sarlavha    String
  tavsif      String
  narx        Int?
  manzil      String
  telefon     String
  amalMuddati DateTime?
  image       String?
  createdBy   String
  banker      Banker      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Singleton row (id is always 1) holding platform-wide, admin-editable settings.
model SystemSettings {
  id                Int      @id @default(1)
  aiPlannerYoqilgan Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}
